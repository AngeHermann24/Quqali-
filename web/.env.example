# Copiez ce fichier en .env.local et renseignez les valeurs (ne jamais commiter .env.local).

# Clé de l'API Claude (console.anthropic.com). Sans clé, les rapports sont générés en mode démonstration.
ANTHROPIC_API_KEY=

# Modèle utilisé pour les rapports mensuels (par défaut : claude-sonnet-5-5).
ANTHROPIC_MODEL=claude-sonnet-5-5

# Clé de tuiles carte (optionnel). Sans clé, l'écran Explorer utilise OpenStreetMap (gratuit).
# Pour des tuiles Mapbox/MapTiler : NEXT_PUBLIC_MAP_KEY=pk.xxx (adapté au fournisseur).
NEXT_PUBLIC_MAP_KEY=
