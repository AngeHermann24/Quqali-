# Copiez ce fichier en .env.local et renseignez les valeurs (ne jamais commiter .env.local).

# Clé de l'API Claude (console.anthropic.com). Sans clé, les rapports sont générés en mode démonstration.
ANTHROPIC_API_KEY=

# Modèle utilisé pour les rapports mensuels (par défaut : claude-sonnet-5-5).
ANTHROPIC_MODEL=claude-sonnet-5-5

# Clé de tuiles carte (optionnel). Sans clé, l'écran Explorer utilise OpenStreetMap (gratuit).
# Pour des tuiles Mapbox/MapTiler : NEXT_PUBLIC_MAP_KEY=pk.xxx (adapté au fournisseur).
NEXT_PUBLIC_MAP_KEY=

# ---- Supabase (dashboard > Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé service_role — serveur uniquement, jamais côté client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Base de données (dashboard > Project Settings > Database) ----
# Connexion poolée (runtime) : « Connection string » onglet « Transaction pooler ».
DATABASE_URL=postgresql://postgres.xxxx:[MOT-DE-PASSE]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
# Connexion directe (migrations Prisma) : onglet « Session pooler » ou URI directe port 5432.
DIRECT_URL=postgresql://postgres.xxxx:[MOT-DE-PASSE]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ---- TWA / Play Store (rempli après génération Bubblewrap) ----
# Nom de package Android de l'app (ex. ci.qualiteplus.app) et empreintes SHA-256 du certificat.
TWA_PACKAGE_NAME=
TWA_SHA256_FINGERPRINTS=
